# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option C: Third-Party Webhook Gateway (WATI, Gupshup, UltraMsg, GreenAPI)
