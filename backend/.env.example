# -------------------------------------------------------------
# 2. WHATSAPP BROCHURE AUTOMATION (Choose ONE provider)
# -------------------------------------------------------------

# Option A: Meta WhatsApp Cloud API (Official Facebook Developer)
# Get from: https://developers.facebook.com/apps -> WhatsApp -> API Setup
# WHATSAPP_CLOUD_API_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=1234567890

