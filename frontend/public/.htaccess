# Apache Rewrite Rules for GoDaddy / cPanel / Shared Hosting
# Directs all route requests to index.html for Single Page Applications (React / Vite)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caching & Security Headers
<IfModule mod_headers.c>
  # Cache static assets (images, fonts, css, js)
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff2?|ttf|css|js)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Do not cache index.html to ensure visitors always receive latest version
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
